{
  "name": "intern-assessment",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "concurrently \"bun run dev:api\" \"bun run dev:web\"",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev:api": "bun run apps/api/index.ts",
    "dev:web": "cd apps/web && bun run dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "cd apps/api && bun run db:push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "cd apps/api && bun run db:seed"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "pg": "^8.23.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "testcontainers": "^12.1.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
